import yfinance as yf
import pandas as pd
import pandas_ta as ta
import numpy as np
from sklearn.ensemble import RandomForestClassifier
from sklearn.metrics import precision_score
import nltk
from nltk.sentiment.vader import SentimentIntensityAnalyzer
import warnings

# --- 1. SETUP: LIBRARIES & ENVIRONMENT ---
warnings.filterwarnings('ignore') # Suppresses Pandas/Scikit-learn warnings for clean output

# Initialize VADER Sentiment Analyzer
print("--- SYSTEM STARTUP 🚀 ---")
try:
    nltk.data.find('vader_lexicon')
except LookupError:
    print("   -> Downloading VADER lexicon...")
    nltk.download('vader_lexicon', quiet=True)

vader = SentimentIntensityAnalyzer()
ticker = "NVDA"

# ==========================================
# PHASE 1 & 2: CORE ENGINE (Scout & General)
# ==========================================

print(f"1. Downloading Live Data for {ticker}...")

# Use period="2y" to fetch the latest available data up to today
# multi_level_index=False prevents Multi-Index issues for the single ticker download
data = yf.download(ticker, period="2y", progress=False, multi_level_index=False)

if data.empty:
    raise ValueError(f"Error: No data found for {ticker}. Script halted.")

print(f"   -> Data fetched successfully up to {data.index[-1].strftime('%Y-%m-%d')}")

# --- FEATURE ENGINEERING ---
# Technical Indicators (The Scout's Eyes)
data['ADX'] = ta.adx(data['High'], data['Low'], data['Close'], length=14)['ADX_14']
data['RSI'] = ta.rsi(data['Close'], length=14)
data['SMA_50'] = ta.sma(data['Close'], length=50)
data['SMA_200'] = ta.sma(data['Close'], length=200)

# Contextual Features (The General's Intelligence)
data['Volatility'] = data['Close'].pct_change().rolling(window=20).std()
data['Volume_Change'] = data['Volume'].pct_change()
data.dropna(inplace=True) # Drop NaNs created by rolling windows

# --- PHASE 1: THE SCOUT (Signal Logic) ---
def scout_strategy(row):
    # Buy Signal: Strong Trend OR Oversold Reversion
    if (row['ADX'] > 25 and row['Close'] > row['SMA_50']) or (row['ADX'] < 20 and row['RSI'] < 30):
        return 1
    return 0
data['Scout_Signal'] = data.apply(scout_strategy, axis=1)

# --- PHASE 2: THE GENERAL (Model Training) ---
print("2. Training The General (Random Forest)...")
# Labeling: Did the price go up > 2% in the next 5 days? (The target)
data['Future_Return'] = data['Close'].shift(-5)
data['Target_Label'] = (data['Future_Return'] > data['Close'] * 1.02).astype(int)

# Create training set only from signal days and drop NaNs (no lookahead bias)
training_data = data[data['Scout_Signal'] == 1].copy()
training_data.dropna(inplace=True) 

features = ['ADX', 'RSI', 'Volatility', 'Volume_Change', 'SMA_50']
X = training_data[features]
y = training_data['Target_Label']

# Train the model
model = RandomForestClassifier(n_estimators=100, min_samples_split=10, random_state=42)
model.fit(X, y)

# --- Check Model Performance (If test set exists) ---
if len(X) > 50: # Only check precision if enough data exists
    split = int(len(X) * 0.8)
    X_test = X.iloc[split:]
    y_test = y.iloc[split:]
    acc = precision_score(y_test, model.predict(X_test), zero_division=0)
    print(f"   -> General's Historical Precision (Buy Signals): {acc:.2%}")

# ==========================================
# PHASE 3 & 4: SAFETY PROTOCOLS
# ==========================================

# --- PHASE 3: THE SHIELD (Sentiment Veto) ---
def get_sentiment_veto(headline_text):
    """Vetoes a trade if compound sentiment score is too negative."""
    score = vader.polarity_scores(headline_text)['compound']
    print(f"   -> NEWS SCAN: '{headline_text}'")
    print(f"   -> SENTIMENT SCORE: {score:.2f}")
    
    # A score below -0.5 is considered highly negative/dangerous
    if score < -0.5:
        return True
    return False

# --- PHASE 4: THE MAP (Macro Risk Sizing) ---
def get_macro_risk():
    """Adjusts position size based on inter-market fear signals."""
    print("   -> SCANNING MACRO ECONOMY...")
    multiplier = 1.0
    
    # Helper to get the latest daily change for a ticker (CRASH-PROOF DOWNLOAD)
    def get_latest_change(ticker_symbol):
        df = yf.download(ticker_symbol, period="5d", progress=False, multi_level_index=False)
        if df.empty or 'Close' not in df.columns or df['Close'].isnull().all():
            return 0.0, False
        return df['Close'].pct_change().iloc[-1], True

    # 1. Check Bonds (^TNX - 10 Year Yield)
    tnx_change, tnx_valid = get_latest_change("^TNX")
    if tnx_valid and tnx_change > 0.03: # Yields jump 3% in a day (Bond Crash = Tech Risk)
        print(f"      [WARNING] Yields Spiked {tnx_change:.2%}. -50% Size.")
        multiplier -= 0.5

    # 2. Check Crypto (BTC-USD - Risk Appetite Proxy)
    btc_change, btc_valid = get_latest_change("BTC-USD")
    if btc_valid and btc_change < -0.05: # Bitcoin drops 5% in a day (Risk-Off Signal)
        print(f"      [WARNING] Bitcoin Crashed {btc_change:.2%}. -30% Size.")
        multiplier -= 0.3
        
    final_multiplier = max(0.0, multiplier)
    print(f"   -> CALCULATED RISK MULTIPLIER: {final_multiplier:.2f}")
    return final_multiplier

# ==========================================
# LIVE EXECUTION ENGINE 🤖
# ==========================================

print("\n==================================")
print("   FINAL TRADING DECISION ENGINE   ")
print("==================================")

# Get the prediction input for the latest day
latest_data = data.iloc[-1]
current_price = latest_data['Close']
print(f"Current Price: ${current_price:.2f}")

# --- STEP 1: THE SCOUT ---
if scout_strategy(latest_data) == 1:
    print("\n[SCOUT] Signal Detected. Reviewing...")
    
    # --- STEP 2: THE GENERAL (Model Probability Check) ---
    current_features = latest_data[features].values.reshape(1, -1)
    confidence = model.predict_proba(current_features)[0][1]
    
    # Adaptive Threshold: Higher volatility requires higher confidence
    dynamic_threshold = min(0.55 + (latest_data['Volatility'] * 5.0), 0.90)
    
    if confidence > dynamic_threshold:
        print("[GENERAL] High Confidence Approval.")
        
        # --- STEP 3: THE SHIELD (Veto Check) ---
        # SIMULATION HEADLINE: Change this to test the VETO power (e.g., "Nvidia CEO arrested on fraud charges")
        latest_headline = "Nvidia announces massive $50 billion share buyback plan"
        
        if get_sentiment_veto(latest_headline):
            print("\nDECISION: >>> VETOED BY SHIELD <<< (Critical Negative News)")
        else:
            # --- STEP 4: THE MAP (Position Sizing) ---
            risk_scaler = get_macro_risk()
            
            standard_size = 100 # shares (Your baseline risk)
            final_size = int(standard_size * risk_scaler)
            
            if final_size > 0:
                print("\n***********************************")
                print(f" FINAL DECISION: >>> BUY EXECUTE <<<")
                print(f" QUANTITY: {final_size} Shares")
                print(f" (Sizing adjusted by Map: {risk_scaler:.0%})")
                print("***********************************")
            else:
                print("\nDECISION: >>> BLOCKED BY MACRO MAP <<< (Risk too high, size 0)")
            
    else:
        print(f"[GENERAL] Confidence ({confidence:.2%}) is below threshold ({dynamic_threshold:.2%}).")
        print("DECISION: VETOED (Insufficient Probability)")
else:
    print("\n[SCOUT] No technical signal detected. System Sleeping.")
